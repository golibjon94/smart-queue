# ============================================
# smart-queue — environment namunasi
# Nusxalash: cp .env.example .env
# .env hech qachon git'ga kirmaydi!
# ============================================

# --- TimescaleDB (Docker, host portda 5433) ---
POSTGRES_USER=smartqueue
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=smartqueue
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Python ML servisi (FastAPI) ---
ML_SERVICE_HOST=localhost
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://localhost:8000

# --- .NET Gateway ---
GATEWAY_PORT=5080
GATEWAY_URL=http://localhost:5080

# JWT (kalit kamida 32 belgi; prod'da albatta almashtiring)
JWT_KEY=dev-only-super-secret-jwt-signing-key-change-me-32b+
JWT_EXPIRY_HOURS=8

# Default admin (birinchi startup'da yaratiladi; keyin DB'da qoladi)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin!2026

# --- Angular dashboard ---
DASHBOARD_PORT=4300
