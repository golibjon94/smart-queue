# ============================================
# smart-queue — environment namunasi
# Nusxalash: cp .env.example .env
# .env hech qachon git'ga kirmaydi!
# ============================================

# --- TimescaleDB (Docker, host portda 5433) ---
POSTGRES_USER=smartqueue
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=smartqueue
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Python ML servisi (FastAPI) ---
ML_SERVICE_HOST=localhost
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://localhost:8000

# --- .NET Gateway ---
GATEWAY_PORT=5080
GATEWAY_URL=http://localhost:5080
# Dashboard so'rovlari uchun oddiy API kalit (Faza 0; to'liq JWT — Faza 1)
GATEWAY_API_KEY=dev_api_key_change_me

# --- Angular dashboard ---
DASHBOARD_PORT=4200
